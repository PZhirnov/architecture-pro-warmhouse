@startuml C4_Контекстная_диаграмма
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include ./C4-PlantUML-master/C4_Context.puml
!include ./C4-PlantUML-master/C4_Container.puml
' !include C4_Component.puml
' !include C4_Code.puml

title Диаграмма контекста: Система «Умный дом»

Person(user, "Житель дома", "Управляет устройствами и просматривает их состояние")
Person(admin, "Администратор / Техник", "Настраивает систему, управляет доступом")

System(smartHome, "Система «Умный дом»", "Монолит на Go: обработка команд, агрегация данных, автоматизация и сценарии")

    System_Ext(webApp, "Веб/Мобильный клиент", "Пользовательский интерфейс (браузер, смартфон)")
    System_Ext(sensors, "Датчики и устройства", "Датчики температуры, положения ворот, освещения и т.п.")

Rel(user, webApp, "Использует")
    Rel(admin, webApp, "Использует")
    Rel(webApp, smartHome, "Отправляет команды и запросы", "HTTPS/REST")
    Rel(smartHome, sensors, "Читает показания и отправляет команды", "REST API")
@enduml